{
  "kernel_version": "2.1",
  "compatibility_version": "1.0",
  "note": "Gate criteria live in data, not code. Declared BEFORE results are measured (Kernel v2.1, section 9).",
  "gates": {
    "GATE_COMMERCIAL_VALIDATION_14D": {
      "gate_id": "GATE_COMMERCIAL_VALIDATION_14D",
      "window_start": "2026-10-10T00:00:00Z",
      "window_end": "2026-10-24T23:59:59Z",
      "success_transition_target": "VALIDATION",
      "failure_transition_target": "ARCHIVED",
      "mandatory_cooldown_hours_on_fail": 48,
      "approval_requirement": "DETERMINISTIC_EVALUATOR",
      "clauses": [
        {
          "clause_id": "clause-organic-conversions",
          "kind": "evidence_count",
          "event_type": "csv_download",
          "operator": ">=",
          "threshold": 15,
          "description": "At least 15 completed CSV conversions downloaded by visitors."
        },
        {
          "clause_id": "clause-paid-intent-signals",
          "kind": "evidence_count",
          "event_type": "pro_intent_click",
          "operator": ">=",
          "threshold": 2,
          "description": "At least 2 distinct user clicks on Pro Saved Rules intent CTA."
        },
        {
          "clause_id": "clause-zero-ad-spend",
          "kind": "economic_ceiling",
          "field": "capital_spent",
          "operator": "==",
          "threshold": 0.00,
          "description": "Strict $0.00 advertising spend throughout the observation period."
        }
      ]
    }
  }
}
